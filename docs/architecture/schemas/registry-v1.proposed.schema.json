{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/congnvp/Chatgpt-tunnel-mcp-manager/blob/main/docs/architecture/schemas/registry-v1.proposed.schema.json",
  "title": "CTMM Registry desired-state V1 (PROPOSED / NOT ACCEPTED)",
  "description": "Structural syntax only. Security, cross-object invariants, authorization, secret resolution, and runtime compatibility require separate trusted validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_revision",
    "profiles",
    "servers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_revision": {
      "type": "integer",
      "minimum": 0
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "servers": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/server"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "display_name",
        "activation_policy"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "activation_policy": {
          "enum": [
            "manual",
            "boot_approved"
          ]
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_id",
        "profile_id",
        "alias",
        "display_name",
        "enabled",
        "transport",
        "execution",
        "exposure"
      ],
      "properties": {
        "server_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "enabled": {
          "type": "boolean"
        },
        "transport": {
          "oneOf": [
            {
              "$ref": "#/$defs/stdio_transport"
            },
            {
              "$ref": "#/$defs/http_transport"
            }
          ]
        },
        "secret_bindings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/secret_binding"
          }
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "exposure": {
          "$ref": "#/$defs/exposure"
        }
      }
    },
    "stdio_transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "executable",
        "args",
        "working_directory"
      ],
      "properties": {
        "kind": {
          "const": "stdio"
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "working_directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "http_transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url"
      ],
      "properties": {
        "kind": {
          "const": "streamable_http"
        },
        "url": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://"
        }
      }
    },
    "secret_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "name",
        "secret_ref"
      ],
      "properties": {
        "target": {
          "enum": [
            "env",
            "http_header"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "secret_ref": {
          "type": "string",
          "minLength": 16,
          "maxLength": 255,
          "pattern": "^secret://ctmm/[a-z0-9][a-z0-9/_-]*$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup_timeout_ms",
        "request_timeout_ms",
        "max_concurrent_requests",
        "restart_policy"
      ],
      "properties": {
        "startup_timeout_ms": {
          "type": "integer",
          "minimum": 500,
          "maximum": 300000
        },
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 500,
          "maximum": 300000
        },
        "max_concurrent_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "restart_policy": {
          "enum": [
            "never",
            "on_failure"
          ]
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "resources",
        "prompts"
      ],
      "properties": {
        "tools": {
          "type": "boolean"
        },
        "resources": {
          "type": "boolean"
        },
        "prompts": {
          "type": "boolean"
        }
      }
    }
  }
}
